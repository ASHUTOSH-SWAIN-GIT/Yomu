{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yomu",
  "version": "0.1.0",
  "identifier": "com.yomu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Yomu",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDNDJFMDJFNjFGRUI3RDYKUldUV3QvNWhMdUJDYkhaWXRPNlc3Zm5kdjlNUmhaL21DV01IQXYwcDVmaEljRTZVUHBmUE9XUGcK",
      "endpoints": [
        "https://github.com/ASHUTOSH-SWAIN-GIT/Yomu/releases/latest/download/latest.json"
      ]
    }
  }
}
